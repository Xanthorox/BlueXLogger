# ===========================================================================
# BlueXLogger - .gitignore
# Created by Xencode-CLI by xanthorox
#
# The rule this file enforces: a `git add .` from the repository root must not
# be able to publish a credential, an operator profile, or a build artefact.
# See the "Publishing to GitHub" section of README.md.
# ===========================================================================

# ---- build outputs (regenerated by build\build.bat) -----------------------
build/bin/
build/obj/
tests/out/

# ---- generated resources (regenerated by build\gen_res.bat) ---------------
res/bluexlogger.ico
res/cfg_slot.bin

# ---- credentials: never publish these -------------------------------------
# A profile carries the serialized configuration including the App Password
# and/or the Telegram bot token. Obfuscated, not encrypted.
*.bxprofile
BlueXLogger.cfg

# The builder's default output folder - configured payloads land here.
build/bin/output/

# ---- editor / OS noise ----------------------------------------------------
.vs/
*.user
*.suo
*.swp
*.tmp
*~
Thumbs.db
Desktop.ini
